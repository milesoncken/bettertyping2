{
  "name": "bettertyping",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @bettertyping/web dev",
    "build": "pnpm --filter @bettertyping/web build",
    "build:packages": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
